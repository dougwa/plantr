# Postgres
POSTGRES_USER=plantr
POSTGRES_PASSWORD=plantr
POSTGRES_DB=plantr
# Use 5433 to avoid colliding with a host Postgres on 5432
POSTGRES_PORT=5433

# API
API_PORT=4000
API_HOST=0.0.0.0
DATABASE_URL=postgresql://plantr:plantr@localhost:5433/plantr?schema=public

# Auth
AUTH_TOKEN_SECRET=change-me-in-production

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000

# PlantNet
PLANTNET_API_KEY=

# DigitalOcean Spaces (photo storage)
SPACES_REGION=sfo3
SPACES_BUCKET=plantr
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
# When "true", signed URLs use the CDN edge (recommended).
SPACES_CDN_ENABLED=true
# Signed-URL TTL in seconds. Spaces caps at 7 days (604800).
SPACES_URL_EXPIRY_SECONDS=86400

# Only used by the one-shot photo migration script.
STORAGE_DIR=./storage
