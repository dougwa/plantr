# Postgres
POSTGRES_USER=plantr
POSTGRES_PASSWORD=plantr
POSTGRES_DB=plantr
# Use 5433 to avoid colliding with a host Postgres on 5432
POSTGRES_PORT=5433

# API
API_PORT=4000
API_HOST=0.0.0.0
DATABASE_URL=postgresql://plantr:plantr@localhost:5433/plantr?schema=public
STORAGE_DIR=./storage

# Auth
AUTH_TOKEN_SECRET=change-me-in-production

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000

# PlantNet
PLANTNET_API_KEY=
