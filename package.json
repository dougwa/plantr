{
  "name": "plantr",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev:db": "docker compose up -d postgres",
    "dev:db:stop": "docker compose down",
    "dev:api": "pnpm --filter @plantr/api dev",
    "dev:web": "pnpm --filter @plantr/web dev",
    "dev:mobile": "pnpm --filter @plantr/mobile start",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "prisma:generate": "pnpm --filter @plantr/api prisma:generate",
    "prisma:migrate": "pnpm --filter @plantr/api prisma:migrate"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
