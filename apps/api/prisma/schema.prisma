generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ActionKind {
  feeding
  watering
  fertilizing
  treating
}

enum TagKind {
  custom
  location
}

model User {
  id             String          @id @default(cuid())
  username       String          @unique
  passwordHash   String
  mustChangePass Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sessions       Session[]
  plants         Plant[]
  photos         Photo[]
  actions        Action[]
  locationShapes LocationShape[]
}

model Session {
  id         String   @id @default(cuid())
  token      String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
}

// Tag is the unified label model. `kind` partitions tags into UX-distinct
// buckets (custom for free-form labels, location for shape-paired labels).
// Location-kind tags are managed by LocationShape and cannot be edited directly.
model Tag {
  id              String         @id @default(cuid())
  name            String
  kind            TagKind        @default(custom)
  locationShapeId String?        @unique
  locationShape   LocationShape? @relation(fields: [locationShapeId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
  plants          Plant[]

  @@unique([kind, name])
}

model Plant {
  id           String   @id @default(cuid())
  qrCode       String   @unique
  name         String?
  species      String?
  description  String?
  notes        String?
  coverPhotoId String?  @unique
  coverPhoto   Photo?   @relation("PlantCover", fields: [coverPhotoId], references: [id], onDelete: SetNull)
  gpsLat       Float?
  gpsLng       Float?
  plantNetData Json?
  createdById  String
  createdBy    User     @relation(fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  photos       Photo[]  @relation("PlantPhotos")
  actions      Action[]
  // Plant-to-location relationship lives in `tags` via location-kind Tags.
  tags         Tag[]
}

model Photo {
  id            String   @id @default(cuid())
  plantId       String
  plant         Plant    @relation("PlantPhotos", fields: [plantId], references: [id], onDelete: Cascade)
  originalPath  String
  thumbnailPath String
  coverPath     String
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  coverOf       Plant?   @relation("PlantCover")

  @@index([plantId])
}

model Action {
  id          String     @id @default(cuid())
  plantId     String
  plant       Plant      @relation(fields: [plantId], references: [id], onDelete: Cascade)
  kind        ActionKind
  notes       String?
  takenAt     DateTime
  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())

  @@index([plantId, takenAt])
}

model LocationShape {
  id              String   @id @default(cuid())
  qrCode          String?  @unique
  name            String?
  kind            String
  color           String
  centerLat       Float
  centerLng       Float
  widthMeters     Float
  heightMeters    Float
  rotationDegrees Float    @default(0)
  locked          Boolean  @default(false)
  polygonPoints   Json?
  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  // Paired Tag (kind=location) is auto-managed by the API. Plants land here
  // via Plant.tags.
  tag             Tag?
}
